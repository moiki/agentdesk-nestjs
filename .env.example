# ──────────────────────────────────────────────
# AgentDesk — Environment Variables
# Copy to .env and fill in values for your environment.
# docker-compose.yml reads this file automatically.
# ──────────────────────────────────────────────

# ── Postgres ──────────────────────────────────
POSTGRES_USER=agentdesk
POSTGRES_PASSWORD=agentdesk
POSTGRES_DB=agentdesk

# Local dev uses port 5433 externally; Docker internal network uses 5432.
DATABASE_URL="postgresql://agentdesk:agentdesk@localhost:5433/agentdesk?schema=public"
TEST_DATABASE_URL="postgresql://agentdesk:agentdesk@localhost:5433/agentdesk_test?schema=public"
# Inside Docker containers (docker-compose), the host is the service name:
# DATABASE_URL_DOCKER="postgresql://agentdesk:agentdesk@postgres:5432/agentdesk?schema=public"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1h"

# Session cookies (HttpOnly): persistence across tabs/reloads
COOKIE_ACCESS_TTL_MS=3600000
COOKIE_REFRESH_TTL_MS=2592000000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Rate limiting ─────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Dev helpers ───────────────────────────────
ALLOW_TENANT_HEADER=false

# ── HTTP security ─────────────────────────────
CORS_ORIGINS=*
BODY_LIMIT=100kb

# ── LLM provider ─────────────────────────────
# Options: fake | anthropic | groq
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-haiku-latest

# ── Groq (OpenAI-compatible) ────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ── Langfuse observability (opt-in) ─────────────
# Tracing is disabled by default. Set LANGFUSE_ENABLED=true to send traces to
# Langfuse. The span processor reads the standard LANGFUSE_* credentials.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Agent loop ────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOTAL_TOKENS=200000
AGENT_MAX_WALL_CLOCK_MS=120000
AGENT_SYSTEM_PROMPT=
AGENT_LLM_MAX_RETRIES=3
