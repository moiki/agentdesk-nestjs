# ──────────────────────────────────────────────
# AgentDesk — Environment Variables
# Copy to .env and fill in values for your environment.
# docker-compose.yml reads this file automatically.
# ──────────────────────────────────────────────

# ── Postgres ──────────────────────────────────
POSTGRES_USER=agentdesk
POSTGRES_PASSWORD=agentdesk
POSTGRES_DB=agentdesk

# Local dev uses port 5433 externally; Docker internal network uses 5432.
DATABASE_URL="postgresql://agentdesk:agentdesk@localhost:5433/agentdesk?schema=public"
TEST_DATABASE_URL="postgresql://agentdesk:agentdesk@localhost:5433/agentdesk_test?schema=public"
# Inside Docker containers (docker-compose), the host is the service name:
# DATABASE_URL_DOCKER="postgresql://agentdesk:agentdesk@postgres:5432/agentdesk?schema=public"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1h"

# ── Rate limiting ─────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Dev helpers ───────────────────────────────
ALLOW_TENANT_HEADER=false

# ── HTTP security ─────────────────────────────
CORS_ORIGINS=*
BODY_LIMIT=100kb

# ── LLM provider ─────────────────────────────
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-haiku-latest

# ── Agent loop ────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOTAL_TOKENS=200000
AGENT_MAX_WALL_CLOCK_MS=120000
AGENT_SYSTEM_PROMPT=
AGENT_LLM_MAX_RETRIES=3
